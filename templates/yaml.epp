<%- |
  Variant[Scalar, Array, Hash] $data,
  Optional[Variant[String, Array[String]]] $comments = undef,
  Boolean $sort_keys = false,
| -%>
<%- if $comments =~ String {
  $comment_lines = [$comments]
} elsif $comments =~ Array {
  $comment_lines = $comments
} else {
  $comment_lines = undef
} -%>
---
# This file is managed with puppet
<% if $comment_lines { -%>
#
<% $comment_lines.each |$msg| { -%>
# <%= $msg %>
<% } -%>
<% } -%>
#
<%- $serialized_data = $sort_keys ? {
  true  => $data ? {
    Hash    => extlib::sort_hash_deep($data),
    default => $data,
  },
  false => $data,
} -%>
<%- $body = regsubst(unwrap(stdlib::to_yaml($serialized_data)), '^---\s', '') -%>
<%= $body -%>
